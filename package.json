{
  "name": "neyvia-app-pdf",
  "version": "0.1.1",
  "description": "Interactive PDF workspace for humans and agents, packaged as a Neyvia MCP App.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobthecomputer/neyvia-app-pdf.git"
  },
  "homepage": "https://github.com/bobthecomputer/neyvia-app-pdf#readme",
  "bugs": {
    "url": "https://github.com/bobthecomputer/neyvia-app-pdf/issues"
  },
  "bin": {
    "neyvia-pdf-app": "src/cli.mjs"
  },
  "files": [
